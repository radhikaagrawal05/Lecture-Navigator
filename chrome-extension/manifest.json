{
  "manifest_version": 3,
  "name": "LectureFind by Radhika Agrawal",
  "version": "1.0.0",
  "description": "Search YouTube lecture transcripts using context-aware NLP. Find any concept instantly.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:8000/*",
    "https://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ]
}
